# 复制成 .env 后填写。.env 已被 .gitignore 忽略，不会进仓库。
#
# 这里的配置只影响「AI 助手（扣子智能体）」的会话隔离，
# 其余配置项不填也能正常启动（见 fitness_management/core/config.py 的默认值）。

# ---------- AI 助手：扣子智能体 ----------
# 智能体 ID，默认值就是项目现在在用的那个，一般不用改
COZE_BOT_ID=7687570944927531048

# ===== 以下三项用于实现「会话隔离」，不填也不会报错，但所有访客会共用一份对话记录 =====
#
# 为什么必须配：
#   扣子把「访问密钥」当作使用者身份。前端写死一个公共 PAT 时，所有访客在扣子眼里
#   是同一个人 —— 打开对话框就能看到别人说过的话（实测确认）。
#   官方只支持用 OAuth JWT + session_name 做隔离，签名要用的私钥不能进浏览器，
#   所以由后端签发。
#
# 怎么拿（一次性，约 2 分钟）：
#   1. 打开 https://www.coze.cn/open/oauth/apps ，右上角「创建新应用」
#   2. 应用类型选「普通」，客户端类型选「服务类应用」
#   3. 在配置页点「创建 Key」，浏览器会把 private_key.pem 下载到本地
#   4. 同一页面记下「应用 ID」和「公钥指纹」，勾选权限后点「授权」完成授权
#   5. 把 pem 放到项目根目录（已被 .gitignore 忽略），或改用下面第二行的内联写法
#
# 应用 ID（JWT 的 iss）
COZE_OAUTH_APP_ID=
# 公钥指纹（JWT header 的 kid）
COZE_OAUTH_KID=
# 私钥文件路径。相对路径按项目根目录解释。
COZE_OAUTH_PRIVATE_KEY_PATH=private_key.pem
# 也可以不用文件，直接把 PEM 全文塞进来（适合部署时从密钥管理服务注入）。
# 注意换行要写成 \n 转义，且本行必须在一行内写完。
# COZE_OAUTH_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# 用 JWT 换 access_token 的接口地址。个人版与企业标准版用默认值即可；
# 只有企业旗舰版的多组织场景才需要改成
# https://api.coze.cn/api/permission/oauth2/account/{account_id}/token
# COZE_TOKEN_URL=https://api.coze.cn/api/permission/oauth2/token

# 申请的访问令牌有效期，单位秒。扣子上限 86399（24 小时），默认 7200（2 小时）
COZE_TOKEN_TTL_SECONDS=7200
# session_name 前缀，给不同业务做区分，避免撞号
COZE_SESSION_PREFIX=gym-
